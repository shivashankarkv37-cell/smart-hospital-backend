# Copy these placeholders into your local environment configuration and replace them there.
# Spring Boot does not load .env files automatically; see AUTHENTICATION.md.
DB_URL=jdbc:mysql://localhost:3306/smart_hospital?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=your_database_username
DB_PASSWORD=replace_with_your_local_database_password

# Base64 for at least 32 cryptographically random bytes (HS256 minimum).
JWT_SECRET=replace_with_your_secure_base64_encoded_secret
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=900

FRONTEND_ORIGIN=http://localhost:5173

# Rule-based FAQ endpoint; set false to return 503 from the assistant endpoint.
ASSISTANT_ENABLED=true
